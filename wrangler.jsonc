{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pgc-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Bakes the knowledge-base markdown files into the Worker bundle as plain
  // strings at build/deploy time (Workers have no filesystem at runtime).
  // See src/knowledge.ts.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // Used for env.AI.gateway(id).patchLog(...) -- the 👍/👎 feedback flow
  // (checklist item 21). Authenticated implicitly by the Worker's own
  // account; no separate token needed for this specific call.
  "ai": {
    "binding": "AI"
  },

  // Serves the chat UI (and, in Phase 2, the /insights admin panel) from ./public.
  // run_worker_first ensures src/index.ts always runs first so it can handle
  // /api/* routes and (later) gate /insights, deferring to static files otherwise.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Per-visitor chat history, keyed by a session cookie. See src/session.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_SESSION",
        "class_name": "ChatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatSession"]
    }
  ],

  // Non-secret config. Secrets (ANTHROPIC_API_KEY, and later the AI Gateway
  // token) are set with `wrangler secret put` and must never be committed here.
  "vars": {
    // Soft backstop for conciseness (primary enforcement is the system
    // prompt's "Keep it short" rule) -- generous enough not to cut off a
    // real multi-item bundle comparison, tight enough to stop runaway essays.
    // (500 was tried and cut a legitimate 6-item bundle breakdown off
    // mid-sentence -- a truncated reply is worse than a slightly longer one.)
    "ANTHROPIC_MAX_TOKENS": "800",
    // Non-secret Gateway identifiers -- used to build the compat endpoint
    // URL for every model call (src/gateway.ts's compatUrl, used by
    // src/claude.ts's multi-model routing, /api/insights, and
    // /api/demo/resilience).
    "CF_ACCOUNT_ID": "0feb844d7ff36330cdd00ed24797fe85",
    "CF_AI_GATEWAY_ID": "pgc-chatbot"
  },

  // Custom Domain: puregroundscoffee.com's zone is on this same Cloudflare
  // account, so `wrangler deploy` creates the DNS record + TLS cert for us.
  "routes": [
    {
      "pattern": "chatbot.puregroundscoffee.com",
      "custom_domain": true
    }
  ]
}
